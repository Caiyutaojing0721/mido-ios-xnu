mido: trace the MMU boundary and let early faults show themselves

0098 showed white + green + yellow, so everything up to the SCTLR_EL1 write is
healthy.  Past that point the machine is silent for two reasons: the early
console is muted until arm_vm_init() relocates it, and the low vectors are
plain "b ." loops, so a fault and a freeze look identical.

Give the kernel a way to speak across the boundary:

  * map the splash into the existing V=P L2 table again (one 32MB Normal-NC
    block), which is what makes the rest possible;

  * draw a fourth breadcrumb (magenta) immediately after SCTLR_EL1 and the
    isb.  It is still a physical store, so it can only land if the MMU came up
    and the V=P mapping is real;

  * point all sixteen low vector slots at a stack-free painter that fills a
    red block at a fixed spot and halts.  It uses compile-time mido geometry,
    so it works with the MMU on and off, and turns "silent freeze" into "an
    exception was taken".

Reading the panel from the bottom band, left to right: white, green, yellow,
magenta, red.
    white only                   page-table build is at fault
    + green                      the MMU enable or the arm_init jump is
    + yellow + magenta           the MMU is up; whatever broke is past it
    + red                        the exception painter ran

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index c3b0752..623011c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -233,42 +233,71 @@ LEXT(_start)
 	.global	EXT(LowExceptionVectorBase)
 LEXT(LowExceptionVectorBase)
 	/* EL1 SP 0 */
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	/* EL1 SP1 */
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	/* EL0 64 */
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	/* EL0 32 */
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align	7
-	b		.
+	b		Llow_vector_paint
 	.align 12, 0
 
+/*
+ * Paint a red block and halt. All sixteen low vector slots land here.
+ *
+ * No stack, no boot_args, no C: this may run before or after the MMU is
+ * enabled, so everything is a compile-time constant for the mido panel
+ * (1080x1920, stride 3240 bytes, 24bpp):
+ *
+ *     0x90001000 + (1920 - 32) * 3240 + 512 * 3 = 0x905D7080
+ *
+ * The splash is mapped V=P in the bootstrap tables, so the same physical
+ * address is valid in both worlds.
+ */
+	.align	2
+Llow_vector_paint:
+	MOV64	x9, 0x905D7080
+	mov		w1, #0xFF			/* red: R=0xFF in RGB888 */
+	mov		x2, #32
+1:	mov		x3, #64
+	mov		x5, x9
+2:	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add		x9, x9, #3240
+	subs	x2, x2, #1
+	b.ne	1b
+	dsb		sy
+3:	wfi
+	b		3b
+
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 /*
  * Provide a global symbol so that we can narrow the V=P mapping to cover
@@ -690,6 +719,21 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+	/*
+	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P L2
+	 * table, so that code running with the MMU on can still reach the panel
+	 * through its physical address. Both the framebuffer and RAM use L1
+	 * index 0, so another create_bootstrap_mapping call would replace the RAM
+	 * L2 table; patch the single L2 entry instead.
+	 */
+	MOV64	x10, 0x90000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
 
 	/*
 	 * Breadcrumb (page tables and mappings built). The MMU is still off, so this writes the
@@ -887,6 +931,33 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+	/*
+	 * Breadcrumb (the MMU is now on).
+	 * Still a physical store, so it only lands if the V=P mapping is real.
+	 */
+	ldr		x9, [x20, #40]			/* Video.v_baseAddr */
+	cbz		x9, 1f
+	ldr		x4, [x20, #56]			/* Video.v_rowBytes */
+	cbz		x4, 1f
+	ldr		x2, [x20, #72]			/* Video.v_height */
+	cmp		x2, #32
+	b.lo	1f
+	sub		x2, x2, #32
+	madd	x9, x2, x4, x9
+	mov		x3, #288
+	add		x9, x9, x3, lsl #2
+	mov		w1, #0x00FF00FF
+	mov		x2, #32
+2:	mov		x3, #64
+	mov		x5, x9
+3:	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	3b
+	add		x9, x9, x4
+	subs	x2, x2, #1
+	b.ne	2b
+1:
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
