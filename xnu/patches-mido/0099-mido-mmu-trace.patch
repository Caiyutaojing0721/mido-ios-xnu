+/*
+ * Exception painter. All sixteen low vector slots land here with the slot
+ * number in x9.
+ *
+ * No stack, no boot_args, no C: this may run before or after the MMU is
+ * enabled, so everything is a compile-time constant for the mido panel
+ * (1080x1920, stride 3240 bytes, 24bpp). It paints two bands:
+ *
+ *   band 1 (0x905BD200, rows 1856..1887): one block at x = slot * 64px,
+ *           always red. Which block lights up says which entry of the
+ *           vector table fired:
+ *               0-3   EL1, SP_EL0   (sync, irq, fiq, serror)
+ *               4-7   EL1, SP_EL1
+ *               8-11  EL0, aarch64
+ *               12-15 EL0, aarch32
+ *
+ *   band 2 (0x905A3D00, rows 1824..1855): ESR_EL1.EC, so the exception
+ *           class is readable:
+ *               column = EC & 0xF      (0x21 instruction abort, 0x25 data
+ *                                       abort, 0x26 SP alignment, ...)
+ *               colour = EC >> 4       red 0, green 1, blue 2, black 3
+ *
+ * The splash is mapped V=P in the bootstrap tables, so the same physical
+ * address is valid with the MMU on or off.
+ */
+	.align	2
+Llow_vector_paint:
+	mrs		x10, esr_el1
+
+	/* band 1: which vector slot */
+	MOV64	x6, 0x905BD200
+	mov		x11, #192
+	madd	x6, x9, x11, x6
+	mov		w1, #0x000000FF		/* red */
+	bl		Lpaint_block
+
+	/* band 2: ESR_EL1.EC as column (low nibble) and colour (high nibble) */
+	lsr		x11, x10, #26
+	and		x12, x11, #0xF
+	MOV64	x6, 0x905A3D00
+	mov		x13, #192
+	madd	x6, x12, x13, x6
+	lsr		x14, x11, #4
+	and		x14, x14, #3
+	lsl		x14, x14, #3		/* 0, 8, 16, 24 */
+	mov		w1, #0xFF
+	lsl		w1, w1, w14
+	bl		Lpaint_block
+
+	dsb		sy
+3:	wfi
+	b		3b
+
+/* x6 = top-left dword, w1 = colour. 48 dwords by 32 rows, stride 3240. */
+Lpaint_block:
+	mov		x2, #32
+1:	mov		x3, #48
+	mov		x5, x6
+2:	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	2b
+	add		x6, x6, #3240
+	subs	x2, x2, #1
+	b.ne	1b
+	ret
+
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 /*
  * Provide a global symbol so that we can narrow the V=P mapping to cover
@@ -690,6 +772,21 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+	/*
+	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P L2
+	 * table, so that code running with the MMU on can still reach the panel
+	 * through its physical address. Both the framebuffer and RAM use L1
+	 * index 0, so another create_bootstrap_mapping call would replace the RAM
+	 * L2 table; patch the single L2 entry instead.
+	 */
+	MOV64	x10, 0x90000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
 
 	/*
 	 * Breadcrumb (page tables and mappings built). The MMU is still off, so this writes the
@@ -887,6 +984,33 @@ common_start:
