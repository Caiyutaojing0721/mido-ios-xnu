diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index a40c573..97c0dc7 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -75,16 +75,33 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
-	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
-	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
-		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
+	/*
+	 * mido is 2 x Cortex-A53 x 4 (MSM8953), so its MPIDR reads
+	 * Cluster.Aff1 : Core.Aff0 (0x0-0x3, 0x100-0x103) -- the opposite of
+	 * SM7150, where the core sits in Aff1 and Aff0 is always zero.  The
+	 * 0078 check above encoded the SM7150 layout, so the very first
+	 * secondary died in it:
+	 *
+	 *   panic: SWEET CPU: invalid topology
+	 *   cpu=1 mpidr=0x1 count=4 @//sweetcpu.cpp/:82
+	 *
+	 * Two places assume phys_id == logical id, and both are true for
+	 * cluster 0 only: the secondary reset stub indexes CpuDataEntries[]
+	 * with (MPIDR & 0xffff) (start.s, HAS_CLUSTER || SWEET), while
+	 * ml_processor_register() indexes it with the logical id.  Cluster 1
+	 * would need a logical->physical remap in the reset path first, so
+	 * refuse it here instead of walking off the array later.
+	 */
+	if ((cpu->phys_id & ~0x3u) != 0 || topology->num_cpus > 4 ||
+	    cpu->cpu_id != (uint32_t)cpu->phys_id) {
+		panic("SWEET CPU: unsupported mido topology cpu=%u mpidr=0x%x count=%u"
+		    " (cluster 0 only, logical==MPIDR, max 4 cores)",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	cpuName = OSSymbol::withCStringNoCopy("Cortex-A53");
 	if (cpuName == NULL) {
 		return false;
 	}
