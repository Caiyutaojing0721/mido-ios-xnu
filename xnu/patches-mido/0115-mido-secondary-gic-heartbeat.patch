diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 26052b7..5c290f8 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -185,6 +185,36 @@ sweet_gicv2_setup(void const *prop, unsigned int prop_size)
 	sweet_gicv2 = TRUE;
 	sweet_gicv2_percpu();
 }
+
+/*
+ * GICC_CTLR/PMR/BPR are banked per CPU interface, so a secondary core can be
+ * running with its own interface still off (PMR 0 masks everything).  The
+ * distributor keeps an SGI pending in that case, but the core cannot take it
+ * until its own interface is enabled - which is exactly the handshake
+ * SweetCPU::initCPU() waits for.  pe_init_fiq() does this through
+ * PE_init_cpu(), but relying on that ordering is fragile, so initCPU() asks
+ * for it explicitly right before sending the self-IPI.
+ */
+void
+sweet_gicv2_cpu_enable(void)
+{
+	if (sweet_gicv2) {
+		sweet_gicv2_percpu();
+	}
+}
+
+/* CTLR/PMR/BPR only: reading GICC_IAR here would acknowledge a live interrupt. */
+void
+sweet_gicv2_cpu_dump(unsigned int cpu)
+{
+	if (sweet_gicv2) {
+		kprintf("SWEET GICv2: cpu=%u gicc ctlr=0x%08x pmr=0x%02x bpr=0x%02x\n",
+		    cpu,
+		    _gic_read32(sweet_gicc_base + GICV2_CPU_CTLR),
+		    _gic_read32(sweet_gicc_base + GICV2_CPU_PMR),
+		    _gic_read32(sweet_gicc_base + GICV2_CPU_BPR));
+	}
+}
 #endif /* SWEET */
 
 void
