diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 9037370..cf40e4e 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -21,6 +21,8 @@
 extern "C" void sweet_secondary_entry(void);
 extern "C" boolean_t sweet_gicv2;
 extern "C" vm_offset_t sweet_gicd_base;
+extern "C" void sweet_gicv2_cpu_enable(void);
+extern "C" void sweet_gicv2_cpu_dump(unsigned int cpu);
 extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
 
 class SweetCPU;
@@ -175,13 +177,29 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 		}
 		/* processor_start() is asynchronous for secondaries in this XNU. */
 		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
+		unsigned int spins = 0;
+		unsigned int resends = 0;
 		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
 		    !sweet_cpu_signal_is_enabled(i)) {
 			if (mach_absolute_time() > deadline) {
-				IOLog("SWEET CPU: cpu=%u mpidr=0x%x NOT alive after 5s\n",
-				    i, topology->cpus[i].phys_id);
+				IOLog("SWEET CPU: cpu=%u mpidr=0x%x NOT alive after 5s "
+				    "(init=%u sig=%u resends=%u)\n",
+				    i, topology->cpus[i].phys_id,
+				    __atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE),
+				    sweet_cpu_signal_is_enabled(i), resends);
 				panic("SWEET CPU: cpu=%u startup timeout (reset/MMU/GIC/SGI)", i);
 			}
+			/* The core reported itself up, but the first SGI was sent while
+			 * it still had DAIF.I set.  GICv3 keeps that pending in GICR;
+			 * a GIC-400 that has not enabled its own CPU interface yet can
+			 * simply lose it.  Re-arm every ~200 ms instead of trusting one
+			 * shot, and count the resends so the timeout is diagnosable. */
+			if (++spins % 200 == 0 &&
+			    __atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) != 0 &&
+			    !sweet_cpu_signal_is_enabled(i)) {
+				cpu->signalCPU(cpu);
+				resends++;
+			}
 			IOSleep(1);
 		}
 		IOLog("SWEET CPU: cpu=%u mpidr=0x%x came alive; SGI1 OK\n",
@@ -214,6 +232,12 @@ SweetCPU::initCPU(bool boot)
 
 	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
 
+	/* GIC-400's CPU interface is banked, so this core may still be masked
+	 * (PMR 0 / GICC_CTLR 0) even though the boot CPU programmed its own.
+	 * Enable ours before the self-IPI, otherwise the SGI cannot be taken.
+	 * No-op when the platform has a GICv3. */
+	sweet_gicv2_cpu_enable();
+
 	/* Secondary startup runs at splsched: queue the self-IPI and return.
 	 * startAll waits for its delivery after the startup thread unmasks IRQs.
 	 * Waiting here with DAIF.I set would deadlock every secondary. */
@@ -222,6 +246,7 @@ SweetCPU::initCPU(bool boot)
 	kprintf("SWEET CPU: cpu=%u entered initCPU mpidr=0x%llx EL%llu IRQs=%u\n",
 	    getCPUNumber(), __builtin_arm_rsr64("MPIDR_EL1") & 0xffffULL,
 	    __builtin_arm_rsr64("CurrentEL") >> 2, ml_get_interrupts_enabled());
+	sweet_gicv2_cpu_dump(getCPUNumber());
 	__atomic_store_n(&initialized, 1, __ATOMIC_RELEASE);
 }
 
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index bd669d7..9792400 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -557,7 +557,19 @@ void
 slave_machine_init(__unused void *param)
 {
 	cpu_machine_init();     /* Initialize the processor */
+#if defined(SWEET)
+	/* Secondary heartbeat.  Between initCPU() and the idle thread there is
+	 * nothing visible: if a core never gets here, the bring-up died inside
+	 * cpu_machine_init(); if it gets here and never takes its SGI, the
+	 * problem is the interrupt path, not the CPU. */
+	kprintf("SWEET CPU: cpu=%u slave_machine_init: initCPU done IRQs=%u\n",
+	    (unsigned int)getCpuDatap()->cpu_number, ml_get_interrupts_enabled());
+#endif
 	clock_init();           /* Init the clock */
+#if defined(SWEET)
+	kprintf("SWEET CPU: cpu=%u slave_machine_init: clock_init done, entering idle\n",
+	    (unsigned int)getCpuDatap()->cpu_number);
+#endif
 }
 
