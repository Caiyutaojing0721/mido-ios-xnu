index 5cdd2f9..8904681 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1897,6 +1897,19 @@ handle_simd_trap(arm_saved_state_t *state, uint32_t esr)
 	__builtin_unreachable();
 }
 
+#if defined(SWEET)
+static inline void
+sweet_gic_eoi(uint64_t iar)
+{
+	if (sweet_gicv2) {
+		/* GIC-400: memory-mapped CPU interface; there is no ICC_EOIR1_EL1. */
+		*(volatile uint32_t *)(sweet_gicc_base + 0x010) = (uint32_t)iar;   /* GICC_EOIR */
+	} else {
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	}
+}
+#endif
+
 void
 sleh_irq(arm_saved_state_t *state)
 {
@@ -1911,8 +1924,16 @@ sleh_irq(arm_saved_state_t *state)
 	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
 	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
 	 */
-	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
-	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
+	/* GIC-400 has no ICC_IAR1_EL1: acknowledge through the CPU interface. */
+	uint64_t iar;
+	uint32_t intid;
+	if (sweet_gicv2) {
+		iar = *(volatile uint32_t *)(sweet_gicc_base + 0x00C);   /* GICC_IAR */
+		intid = (uint32_t)(iar & 0x3FF);
+	} else {
+		iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+		intid = (uint32_t)(iar & 0xFFFFFF);
+	}
 
 	if (intid >= 1020 && intid <= 1023) {
 		return; /* spurious */
@@ -1923,11 +1944,11 @@ sleh_irq(arm_saved_state_t *state)
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
 		rtclock_intr(TRUE);
 		INTERRUPT_MASKED_DEBUG_END();
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		sweet_gic_eoi(iar);
 	} else if (intid < 16) {
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_IPI);
 		/* Ack before handling so an IPI raised meanwhile is not lost */
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		sweet_gic_eoi(iar);
 		__builtin_arm_isb(ISB_SY);
 		cpu_signal_handler();
 	} else {
@@ -1938,7 +1959,7 @@ sleh_irq(arm_saved_state_t *state)
 			    cdp->interrupt_nub,
 			    intid);
 		}
-		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+		sweet_gic_eoi(iar);
 	}
 	__builtin_arm_isb(ISB_SY);
 #else
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..26052b7 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -20,6 +20,30 @@ MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS,
 #if defined(SWEET)
 /* Phone default; QEMU virt wires the architected virtual timer to INTID 27. */
 SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+/*
+ * Not every SoC in the sweet family has a GICv3.  MSM8937/MSM8953 (Cortex-A53,
+ * santoni/mido) ship a GIC-400: a memory-mapped CPU interface and no
+ * redistributor at all, so find_gicr_pe_base() would walk the CPU-interface
+ * window looking for GICR_TYPER and panic.  The ADT says which controller we
+ * have, so this is a runtime decision and polaris keeps the GICv3 path as is.
+ */
+SECURITY_READ_ONLY_LATE(boolean_t) sweet_gicv2 = FALSE;
+SECURITY_READ_ONLY_LATE(vm_offset_t) sweet_gicd_base = 0;
+SECURITY_READ_ONLY_LATE(vm_offset_t) sweet_gicc_base = 0;
+
+#define GICV2_DIST_CTLR       0x0000
+#define GICV2_DIST_TYPER      0x0004
+#define GICV2_DIST_IGROUPR    0x0080
+#define GICV2_DIST_ISENABLER  0x0100
+#define GICV2_DIST_IPRIORITYR 0x0400
+#define GICV2_DIST_ITARGETSR  0x0800
+#define GICV2_DIST_SGIR       0x0F00
+#define GICV2_CPU_CTLR        0x0000
+#define GICV2_CPU_PMR         0x0004
+#define GICV2_CPU_BPR         0x0008
+#define GICV2_CPU_IAR         0x000C
+#define GICV2_CPU_EOIR        0x0010
 #endif
 
 static vm_offset_t gicd_base;
@@ -73,12 +97,110 @@ find_gicr_pe_base()
 	panic("%s: cannot find GICR base for core %u", __func__, ml_get_cpu_number(phys_id));
 }
 
+#if defined(SWEET)
+/* "compatible" is a list of NUL-separated strings; there is no strcmp here. */
+static boolean_t
+sweet_dt_compat_has(DTEntry entry, const char *want)
+{
+	void const *prop;
+	unsigned int prop_size;
+
+	if (SecureDTGetProperty(entry, "compatible", &prop, &prop_size) != kSuccess) {
+		return FALSE;
+	}
+
+	const char *list = (const char *)prop;
+	unsigned int i = 0;
+	while (i < prop_size) {
+		unsigned int j = 0;
+		while (i + j < prop_size && list[i + j] != '\0' &&
+		    want[j] != '\0' && list[i + j] == want[j]) {
+			j++;
+		}
+		if (want[j] == '\0' && (i + j == prop_size || list[i + j] == '\0')) {
+			return TRUE;
+		}
+		while (i < prop_size && list[i] != '\0') {
+			i++;
+		}
+		i++;
+	}
+	return FALSE;
+}
+
+/* GIC-400 CPU interface: these registers are banked per CPU, so every CPU runs this. */
+static void
+sweet_gicv2_percpu(void)
+{
+	_gic_write32(sweet_gicc_base + GICV2_CPU_PMR, 0xFF);
+	_gic_write32(sweet_gicc_base + GICV2_CPU_BPR, 0x00);
+	_gic_write32(sweet_gicc_base + GICV2_CPU_CTLR, 0x01);   /* EnableGrp1, NS view */
+	_gic_write32(sweet_gicd_base + GICV2_DIST_CTLR, 0x01);  /* EnableGrp1, NS view */
+	__builtin_arm_isb(ISB_SY);
+}
+
+static void
+sweet_gicv2_setup(void const *prop, unsigned int prop_size)
+{
+	if (prop_size < 4 * sizeof(uint64_t)) {
+		panic("%s: GIC-400 needs <gicd base,size> <gicc base,size>; reg is %u bytes",
+		    __func__, prop_size);
+	}
+
+	vm_offset_t const soc = pe_arm_get_soc_base_phys();
+	uint64_t const gicd_prop = ((uint64_t const *)prop)[0];
+	uint64_t const gicd_size = ((uint64_t const *)prop)[1];
+	uint64_t const gicc_prop = ((uint64_t const *)prop)[2];
+	uint64_t const gicc_size = ((uint64_t const *)prop)[3];
+
+	sweet_gicd_base = ml_io_map(soc + gicd_prop, gicd_size);
+	sweet_gicc_base = ml_io_map(soc + gicc_prop, gicc_size);
+	if (!sweet_gicd_base || !sweet_gicc_base) {
+		panic("%s: cannot map GIC-400 gicd=0x%llx/0x%llx gicc=0x%llx/0x%llx",
+		    __func__, (unsigned long long)(soc + gicd_prop),
+		    (unsigned long long)gicd_size, (unsigned long long)(soc + gicc_prop),
+		    (unsigned long long)gicc_size);
+	}
+
+	uint32_t const typer = _gic_read32(sweet_gicd_base + GICV2_DIST_TYPER);
+	uint32_t const lines = (typer & 0x1FU) + 1;   /* one line = 32 INTIDs */
+	kprintf("SWEET GICv2: soc 0x%lx gicd 0x%lx gicc 0x%lx typer 0x%08x lines %u vtimer %u\n",
+	    (unsigned long)soc, (unsigned long)sweet_gicd_base,
+	    (unsigned long)sweet_gicc_base, typer, lines, sweet_vtimer_intid);
+
+	/* Everything we own is Group 1, so it is signalled as an IRQ (see sleh_irq). */
+	for (uint32_t i = 0; i < lines; i++) {
+		_gic_write32(sweet_gicd_base + GICV2_DIST_IGROUPR + i * 4, 0xFFFFFFFF);
+	}
+	for (uint32_t i = 0; i < lines * 8; i++) {
+		_gic_write32(sweet_gicd_base + GICV2_DIST_IPRIORITYR + i * 4, 0xA0A0A0A0);
+	}
+	/* ITARGETSR: the first 32 INTIDs (SGI+PPI) are banked per CPU and read-only. */
+	for (uint32_t i = 8; i < lines * 8; i++) {
+		_gic_write32(sweet_gicd_base + GICV2_DIST_ITARGETSR + i * 4, 0x01010101);
+	}
+	_gic_write32(sweet_gicd_base + GICV2_DIST_ISENABLER + (sweet_vtimer_intid / 32) * 4,
+	    1U << (sweet_vtimer_intid % 32));
+
+	sweet_gicv2 = TRUE;
+	sweet_gicv2_percpu();
+}
+#endif /* SWEET */
+
 void
 pe_init_fiq()
 {
 	int error;
 	DTEntry entry;
 
+#if defined(SWEET)
+	if (sweet_gicv2) {
+		/* GIC-400: the distributor is programmed once, the CPU interface is banked. */
+		sweet_gicv2_percpu();
+		return;
+	}
+#endif
+
 	// gicd_base is 0x0 only before it's initialized by the boot processor.
 	// Avoid calling SecureDT* routines on secondary processors to avoid
 	// race conditions because they are not thread-safe.
@@ -119,6 +241,13 @@ pe_init_fiq()
 		kprintf("SWEET GIC: virtual timer INTID %u\n", sweet_vtimer_intid);
 #endif
 
+#if defined(SWEET)
+		if (sweet_dt_compat_has(entry, "arm,gic-400")) {
+			sweet_gicv2_setup(prop, prop_size);
+			return;
+		}
+#endif
+
 		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
 
 		uint64_t const gicd_base_prop = ((uint64_t const *) prop)[0];
