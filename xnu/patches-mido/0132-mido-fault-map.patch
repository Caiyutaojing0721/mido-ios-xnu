 /* in osfmk/arm/pmap/pmap.c */
 extern void mido_walk_report(void *pmap, unsigned long long v);
 
+/*
+ * mido: print the address space around a fault the VM refused.
+ *
+ * Two facts decide where to look next, and neither is visible in a photograph
+ * of the registers alone:
+ *
+ *   which entry holds pc        that names the image the instruction came from
+ *   whether the low 32 bits     if the low half is mapped somewhere sane, the
+ *   of the address are mapped   pointer was assembled from the wrong halves and
+ *                               the bug is in whoever read it as 64 bits; if it
+ *                               is not mapped either, the pointer is garbage
+ *
+ * Entries are capped at twenty and printed as 32-bit halves so every token
+ * survives a photograph.
+ */
+static void
+mido_map_report(vm_map_t map, uint64_t pc, uint64_t fault_addr)
+{
+	vm_map_entry_t entry;
+	unsigned int i = 0;
+
+	kprintf("MIDO MAP: %u entries\n", map->hdr.nentries);
+	for (entry = vm_map_first_entry(map);
+	    entry != vm_map_to_entry(map) && i < 20;
+	    entry = entry->vme_next, i++) {
+		kprintf("MIDO MAP %u: %08x.%08x-%08x.%08x p%x\n", i,
+		    (uint32_t)(entry->vme_start >> 32),
+		    (uint32_t)entry->vme_start,
+		    (uint32_t)(entry->vme_end >> 32),
+		    (uint32_t)entry->vme_end,
+		    (unsigned int)entry->protection);
+	}
+	if (vm_map_lookup_entry(map, pc, &entry)) {
+		kprintf("MIDO MAP: pc %08x.%08x in %08x.%08x-%08x.%08x p%x\n",
+		    (uint32_t)(pc >> 32), (uint32_t)pc,
+		    (uint32_t)(entry->vme_start >> 32),
+		    (uint32_t)entry->vme_start,
+		    (uint32_t)(entry->vme_end >> 32),
+		    (uint32_t)entry->vme_end,
+		    (unsigned int)entry->protection);
+	} else {
+		kprintf("MIDO MAP: pc %08x.%08x in no entry\n",
+		    (uint32_t)(pc >> 32), (uint32_t)pc);
+	}
+	if (fault_addr > 0xffffffffULL &&
+	    vm_map_lookup_entry(map, (vm_map_offset_t)(uint32_t)fault_addr,
+	    &entry)) {
+		kprintf("MIDO MAP: low32 %08x in %08x.%08x-%08x.%08x p%x\n",
+		    (uint32_t)fault_addr,
+		    (uint32_t)(entry->vme_start >> 32),
+		    (uint32_t)entry->vme_start,
+		    (uint32_t)(entry->vme_end >> 32),
+		    (uint32_t)entry->vme_end,
+		    (unsigned int)entry->protection);
+	} else {
+		kprintf("MIDO MAP: low32 %08x unmapped\n", (uint32_t)fault_addr);
+	}
+}
+
