 handle_user_abort(arm_saved_state_t *state, uint32_t esr, vm_offset_t fault_addr,
     fault_status_t fault_code, vm_prot_t fault_type, expected_fault_handler_t expected_fault_handler)
@@ -1490,6 +1549,25 @@ handle_user_abort(arm_saved_state_t *state, uint32_t esr, vm_offset_t fault_addr
 				    (uint32_t)(pc >> 32), (uint32_t)pc,
 				    (uint32_t)(lr >> 32), (uint32_t)lr,
 				    (uint32_t)(sp >> 32), (uint32_t)sp);
+				mido_map_report(map, pc, vm_fault_addr);
+				{
+					unsigned int r;
+
+					for (r = 0; r < 16; r += 4) {
+						uint64_t a = get_saved_state_reg(state, r);
+						uint64_t b = get_saved_state_reg(state, r + 1);
+						uint64_t c = get_saved_state_reg(state, r + 2);
+						uint64_t d = get_saved_state_reg(state, r + 3);
+
+						kprintf("MIDO REGS x%u: %08x.%08x "
+						    "%08x.%08x %08x.%08x %08x.%08x\n",
+						    r,
+						    (uint32_t)(a >> 32), (uint32_t)a,
+						    (uint32_t)(b >> 32), (uint32_t)b,
+						    (uint32_t)(c >> 32), (uint32_t)c,
+						    (uint32_t)(d >> 32), (uint32_t)d);
+					}
+				}
 				mido_walk_report((void *)map->pmap, vm_fault_addr);
 			}
 		}
