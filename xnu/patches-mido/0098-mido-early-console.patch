diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 81f2f7e..2d79d95 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -14,6 +14,13 @@
 static volatile uint8_t *early_fb = (volatile uint8_t *)(uintptr_t)0x90001000;
 static unsigned int early_width = 1080, early_height = 1920;
 static unsigned int early_stride = 3240, early_bpp = 3;
+
+/*
+ * The bootstrap page tables are not known to cover the panel, and an
+ * unmapped write is fatal this early. Stay silent until arm_vm_init()
+ * has installed a real alias and calls sweet_early_relocate().
+ */
+static unsigned int early_fb_live;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH early_width
 #define EARLY_HEIGHT early_height
@@ -33,8 +40,12 @@ extern unsigned char iso_font[256 * 16];
 static void
 sweet_early_put(unsigned int x, unsigned int y, uint32_t color)
 {
-	volatile uint8_t *p = EARLY_FB + (uintptr_t)y * EARLY_STRIDE +
-	    (uintptr_t)x * early_bpp;
+	volatile uint8_t *p;
+
+	if (!early_fb_live) {
+		return;
+	}
+	p = EARLY_FB + (uintptr_t)y * EARLY_STRIDE + (uintptr_t)x * early_bpp;
 
 	if (early_bpp == 4) {
 		*(volatile uint32_t *)p = color;
@@ -88,7 +99,7 @@ sweet_early_clear_row(void)
 void
 sweet_early_putc(char c)
 {
-	if (early_disabled) {
+	if (early_disabled || !early_fb_live) {
 		return;
 	}
 	if (!early_started) {
@@ -135,7 +146,7 @@ sweet_early_string(const char *s)
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 20) {
+	if (early_disabled || !early_fb_live || stage > 20) {
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
@@ -174,9 +185,13 @@ sweet_early_panic(const char *fmt, va_list *args)
 void
 sweet_early_relocate(uint64_t base)
 {
-	sweet_early_mark(8, "leaving bootstrap TTBR0");
 	early_fb = (volatile uint8_t *)(uintptr_t)base;
+	early_row = 0;
+	early_col = 0;
+	early_started = 0;
+	early_fb_live = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_mark(8, "leaving bootstrap TTBR0");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
 
