 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
-#if defined(SWEET)
+
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Breadcrumb (page tables and mappings built). The MMU is still off, so this writes the
+	 * physical address from boot_args and cannot fault.
 	 */
-	MOV64	x10, 0x90000000
-	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
-	orr		x11, x11, x10
-	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
-	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
-	add		x13, x25, #(2 * PGBYTES)
-	str		x11, [x13, x12, lsl #TTE_SHIFT]
-#endif
+	ldr		x9, [x20, #40]			/* Video.v_baseAddr */
+	cbz		x9, 1f
+	ldr		x4, [x20, #56]			/* Video.v_rowBytes */
+	cbz		x4, 1f
+	ldr		x2, [x20, #72]			/* Video.v_height */
+	cmp		x2, #32
+	b.lo	1f
+	sub		x2, x2, #32
+	madd	x9, x2, x4, x9
+	mov		x3, #96
+	add		x9, x9, x3, lsl #2
+	mov		w1, #0x0000FF00
+	mov		x2, #32
+2:	mov		x3, #64
+	mov		x5, x9
+3:	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	3b
+	add		x9, x9, x4
+	subs	x2, x2, #1
+	b.ne	2b
+1:
 
 	/* Ensure TTEs are visible */
 	dsb		ish
@@ -845,6 +856,33 @@ common_start:
 #endif /* HAS_APPLE_PAC */
 
 	// Enable caches, MMU, ROP and JOP
+
+	/*
+	 * Breadcrumb (about to enable the MMU). The MMU is still off, so this writes the
+	 * physical address from boot_args and cannot fault.
+	 */
+	ldr		x9, [x20, #40]			/* Video.v_baseAddr */
+	cbz		x9, 1f
+	ldr		x4, [x20, #56]			/* Video.v_rowBytes */
+	cbz		x4, 1f
+	ldr		x2, [x20, #72]			/* Video.v_height */
+	cmp		x2, #32
+	b.lo	1f
+	sub		x2, x2, #32
+	madd	x9, x2, x4, x9
+	mov		x3, #192
+	add		x9, x9, x3, lsl #2
+	mov		w1, #0x0000FFFF
+	mov		x2, #32
+2:	mov		x3, #64
+	mov		x5, x9
+3:	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	3b
+	add		x9, x9, x4
+	subs	x2, x2, #1
