mido: the ARMv8.0 baseline the A53 really is (no PAN, no LSE)

Cortex-A53 is ARMv8.0-A.  Two ARMv8.1 features are used by XNU 8796
without a fallback path, and both are hard failures on mido:

* PSTATE.PAN.  pexpert/pexpert/arm64/SWEET.h claims PAN is available,
  so osfmk/arm64/{copyio,pcb,platform_tests}.c call
  __builtin_arm_rsr("pan") / __builtin_arm_wsr("pan", ...) and clang
  dies in the backend: `Invalid register name "pan"`.  `msr PAN, #1`
  would be UNDEFINED at run time too, so this is not just a build fix.

* LSE `casa`.  osfmk/arm/commpage/commpage_asm.s grabs the pfz lock
  with `casa w10, w11, [x3]`, which needs +lse to assemble.  It is
  spelled as an ldaxr/stxr pair with the same contract (w10 = value
  read, w11 = 1 = locked, so the existing `cbz w10, ...success` still
  decides).  XNU's own machine_routines_asm.s already has exactly this
  same #if fallback for pre-8.2 cores.

Everything else survives the baseline: compiler-generated atomics go
through <stdatomic.h> and follow -mcpu, and machine_routines_asm.s
guards its LSE path with __ARM_ARCH_8_2__.

diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -273,7 +273,15 @@
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	// ARMv8.0 baseline (mido): no LSE, so the 8.1 `casa` is an
+	// ldaxr/stxr pair.  Same contract: w10 = value read from the
+	// lock word, w11 = 1 = locked.
+	Ltrylock_enqueue_cas:
+	ldaxr	w10, [x3]
+	cbnz	w10, Ltrylock_enqueue_cas_done
+	stxr	w12, w11, [x3]
+	cbnz	w12, Ltrylock_enqueue_cas
+	Ltrylock_enqueue_cas_done:
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,7 +331,15 @@
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	// ARMv8.0 baseline (mido): no LSE, so the 8.1 `casa` is an
+	// ldaxr/stxr pair.  Same contract: w10 = value read from the
+	// lock word, w11 = 1 = locked.
+	Ltrylock_dequeue_cas:
+	ldaxr	w10, [x2]
+	cbnz	w10, Ltrylock_dequeue_cas_done
+	stxr	w12, w11, [x2]
+	cbnz	w12, Ltrylock_dequeue_cas
+	Ltrylock_dequeue_cas_done:
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -33,7 +33,15 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-#define __ARM_PAN_AVAILABLE__     1
+/*
+ * mido: NO PAN.
+ *
+ * PSTATE.PAN is an ARMv8.1 field and the Cortex-A53 (SDM8953) implements
+ * ARMv8.0-A, so `msr PAN, #1` is UNDEFINED and `__builtin_arm_rsr("pan")`
+ * makes clang abort in the backend with `Invalid register name "pan"`.
+ * Leaving this at 1 costs us nothing but a hardening feature we cannot use.
+ */
+#define __ARM_PAN_AVAILABLE__     0
 /*
  * No __ARM_16K_PG__ here.
  *
