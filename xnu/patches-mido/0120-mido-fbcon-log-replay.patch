--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -723,6 +723,71 @@
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
 
 /*
+ * Log ring + freeze/replay.
+ *
+ * The console wraps around instead of scrolling, so by the time a bring-up
+ * failure settles into a crash loop the lines that explain it have already
+ * been overwritten.  Keep the last FBCON_RING_BYTES of output in a ring and,
+ * when a trigger fires, stop drawing live output and replay the ring one
+ * screen at a time -- each screen held for FBCON_REPLAY_HOLD_MS -- then park
+ * the CPU on the final screen so the tail can be photographed or filmed.
+ *
+ * Triggers, both optional, both off by default:
+ *   -v fbconhalt=corpses    freeze on the first line containing "corpses"
+ *   -v fbconfreeze=1200     freeze unconditionally after 1200 lines
+ *
+ * The screen is 60 rows x 67 columns at 1080x1920 with FBCON_SCALE 2, and
+ * the ring covers roughly 2000 lines, i.e. about 34 screens of history.
+ */
+#define FBCON_RING_BYTES        (160 * 1024)
+#define FBCON_REPLAY_HOLD_MS    1800
+#define FBCON_REPLAY_PASSES     2
+#define FBCON_LINE_MAX          96
+
+static char fbcon_ring[FBCON_RING_BYTES];
+static uint32_t fbcon_ring_pos;
+static uint32_t fbcon_ring_total;
+static char fbcon_line[FBCON_LINE_MAX];
+static uint32_t fbcon_line_len;
+static uint32_t fbcon_line_no;
+static int fbcon_frozen;
+static uint32_t fbcon_freeze_lines;
+static char fbcon_freeze_pattern[FBCON_LINE_MAX];
+static int fbcon_freeze_armed;
+
+static uint64_t
+fbcon_ticks(void)
+{
+	uint64_t v;
+	__asm__ volatile("mrs %0, cntpct_el0" : "=r"(v));
+	return v;
+}
+
+/* Only used to pace the replay; accuracy does not matter. */
+static void
+fbcon_delay_ms(uint32_t ms)
+{
+	uint64_t freq, end;
+
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(freq));
+	if (freq == 0) {
+		freq = 19200000;
+	}
+	end = fbcon_ticks() + (freq / 1000) * ms;
+	while (fbcon_ticks() < end) {
+		__asm__ volatile("yield");
+	}
+}
+
+static void
+fbcon_ring_put(uint8_t c)
+{
+	fbcon_ring[fbcon_ring_pos] = (char)c;
+	fbcon_ring_pos = (fbcon_ring_pos + 1) % FBCON_RING_BYTES;
+	fbcon_ring_total++;
+}
+
+/*
  * One pixel. At 32bpp the word goes straight into the mapped buffer; at
  * 24bpp the splash is byte-packed, one byte per channel, so the channels
  * have to be written out individually.
@@ -778,19 +843,23 @@
 	return 1;
 }
 
