+static int
+fbcon_draw_char(uint8_t c)
 {
+	int wrapped = 0;
+
 	if (c == '\r') {
 		fbcon_col = 0;
-		return;
+		return 0;
 	}
 	if (c == '\n') {
 		fbcon_newline();
-		return;
+		return 1;
 	}
 	if (fbcon_col >= fbcon_cols) {
 		fbcon_newline();
+		wrapped = 1;
 	}
 	const unsigned char *glyph = iso_font + c * 16;
 	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
@@ -806,6 +875,151 @@
 		}
 	}
 	fbcon_col++;
+	return wrapped;
+}
+
+static int
+fbcon_contains(const char *hay, const char *needle)
+{
+	if (needle[0] == 0) {
+		return 0;
+	}
+	for (const char *h = hay; *h; h++) {
+		const char *a = h, *b = needle;
+		while (*b && *a == *b) {
+			a++;
+			b++;
+		}
+		if (*b == 0) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+static int
+fbcon_trigger_hit(void)
+{
+	if (!fbcon_freeze_armed) {
+		return 0;
+	}
+	if (fbcon_freeze_pattern[0] && fbcon_contains(fbcon_line, fbcon_freeze_pattern)) {
+		return 1;
+	}
+	if (fbcon_freeze_lines && fbcon_line_no >= fbcon_freeze_lines) {
+		return 1;
+	}
+	return 0;
+}
+
+static void
+fbcon_page_header(uint32_t page, uint32_t pages)
+{
+	char buf[32];
+	int n = 0;
+
+	buf[n++] = '=';
+	buf[n++] = '=';
+	buf[n++] = ' ';
+	buf[n++] = 'P';
+	buf[n++] = 'A';
+	buf[n++] = 'G';
+	buf[n++] = 'E';
+	buf[n++] = ' ';
+	if (page >= 10) {
+		buf[n++] = (char)('0' + (page / 10) % 10);
+	}
+	buf[n++] = (char)('0' + page % 10);
+	buf[n++] = '/';
+	if (pages >= 10) {
+		buf[n++] = (char)('0' + (pages / 10) % 10);
+	}
+	buf[n++] = (char)('0' + pages % 10);
+	buf[n++] = ' ';
+	buf[n++] = '=';
+	buf[n++] = '=';
+	buf[n] = 0;
+
+	for (int i = 0; i < n; i++) {
+		fbcon_draw_char((uint8_t)buf[i]);
+	}
+	fbcon_draw_char('\n');
+}
+
+/*
+ * Replay the ring.  Never returns: once the log has been shown, the only
+ * useful thing left to do is hold the last screen still.
+ */
+static void
+fbcon_replay(void)
+{
+	uint32_t len = fbcon_ring_total < FBCON_RING_BYTES ? fbcon_ring_total : FBCON_RING_BYTES;
+	uint32_t start = fbcon_ring_total < FBCON_RING_BYTES ? 0 : fbcon_ring_pos;
+	uint32_t total_rows = 1;
+	uint32_t per_page, pages;
+
+	for (uint32_t i = 0; i < len; i++) {
+		if (fbcon_ring[(start + i) % FBCON_RING_BYTES] == '\n') {
+			total_rows++;
+		}
+	}
+	per_page = fbcon_rows > 4 ? fbcon_rows - 3 : 1;
+	pages = (total_rows + per_page - 1) / per_page;
+
+	for (int pass = 0; pass < FBCON_REPLAY_PASSES; pass++) {
+		uint32_t page = 1;
+		uint32_t rows = 0;
+
+		fbcon_init();
+		fbcon_page_header(page, pages);
+		for (uint32_t i = 0; i < len; i++) {
+			uint8_t c = (uint8_t)fbcon_ring[(start + i) % FBCON_RING_BYTES];
+
+			if (c < 0x20 && c != '\n' && c != '\r') {
+				continue;
+			}
+			if (fbcon_draw_char(c) && ++rows >= per_page) {
+				fbcon_delay_ms(FBCON_REPLAY_HOLD_MS);
+				page++;
+				rows = 0;
+				fbcon_init();
+				fbcon_page_header(page, pages);
+			}
+		}
+		fbcon_delay_ms(FBCON_REPLAY_HOLD_MS);
+	}
+
+	for (;;) {
+		__asm__ volatile("wfi");
+	}
+}
+
+static void
+fbcon_transmit_data(uint8_t c)
+{
+	int hit = 0;
+
+	if (fbcon_frozen) {
+		return;
+	}
+
+	fbcon_ring_put(c);
+
+	if (c == '\n') {
+		fbcon_line[fbcon_line_len] = 0;
+		fbcon_line_no++;
+		hit = fbcon_trigger_hit();
+		fbcon_line_len = 0;
+	} else if (c != '\r' && fbcon_line_len + 1 < FBCON_LINE_MAX) {
+		fbcon_line[fbcon_line_len++] = (char)c;
+	}
+
+	fbcon_draw_char(c);
+
+	if (hit) {
+		fbcon_frozen = 1;
+		fbcon_replay();
+	}
 }
 
