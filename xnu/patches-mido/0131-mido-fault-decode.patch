+/*
+ * mido: dump the page table walk for an address whose fault the VM refused.
+ *
+ * The report from handle_user_abort() says only that vm_fault() gave up.  It
+ * cannot say which of two things happened:
+ *
+ *   the hardware is right   nothing is mapped here at any level, so the
+ *                           program computed a wild pointer
+ *   the hardware is wrong   a descriptor left over from an earlier life of
+ *                           this page table made the walker believe in a
+ *                           mapping the VM has never heard of
+ *
+ * They need opposite fixes, and the difference is visible exactly one way:
+ * walk the tables and print what each level holds.  The first level that is
+ * not a table pointer, and the value it holds, is the answer.
+ *
+ * Bounded to a few reports: a dying launchd takes a dozen daemons with it and
+ * the console ring only holds about 2000 lines.
+ */
+void
+mido_walk_report(
+	void                    *pmap_arg,
+	unsigned long long       v_arg)
+{
+	static uint32_t reports;
+	pmap_t pmap = (pmap_t)pmap_arg;
+	vm_map_address_t v = (vm_map_address_t)v_arg;
+	const pt_attr_t * const pt_attr = pmap_get_pt_attr(pmap);
+	tt_entry_t *table = (tt_entry_t *)pmap->tte;
+	unsigned int root_level = pt_attr_root_level(pt_attr);
+	unsigned int leaf_level = pt_attr_leaf_level(pt_attr);
+	unsigned int level;
+
+	if (reports >= 4) {
+		return;
+	}
+	reports++;
+
+	printf("MIDO WALK: pmap=%p min=0x%llx max=0x%llx levels %u..%u\n",
+	    pmap, (unsigned long long)pmap->min,
+	    (unsigned long long)pmap->max, root_level, leaf_level);
+
+	if (table == NULL) {
+		printf("MIDO WALK: no root table\n");
+		return;
+	}
+
+	for (level = root_level; level <= leaf_level; level++) {
+		unsigned int idx = (unsigned int)ttn_index(pt_attr, v, level);
+		tt_entry_t tte = table[idx];
+
+		if (level == leaf_level) {
+			printf("MIDO WALK L%u[%u] leaf pte=0x%llx af=%llu\n",
+			    level, idx, (unsigned long long)tte,
+			    (unsigned long long)((tte >> 10) & 1));
+			return;
+		}
+		printf("MIDO WALK L%u[%u] tte=0x%llx\n", level, idx,
+		    (unsigned long long)tte);
+		if ((tte & (ARM_TTE_TYPE_MASK | ARM_TTE_VALID)) !=
+		    (ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)) {
+			printf("MIDO WALK: L%u is not a table pointer, "
+			    "walk ends here\n", level);
+			return;
+		}
+		table = (tt_entry_t *)phystokv(tte & ARM_TTE_TABLE_MASK);
+	}
+}
