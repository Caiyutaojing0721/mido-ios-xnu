+/*
+ * mido: name the fault the way the ARM ARM does.
+ *
+ * A photographed console cannot resolve an eight-digit ESR reliably, and the
+ * bit that matters here lives in the low six bits: "translation fault, level
+ * 0" means nothing is mapped and the program used a wild pointer, while
+ * "permission fault, level 3" means a translation exists but does not allow
+ * the access.  Those two need opposite fixes, so say which one it is in words
+ * rather than leaving it to a photograph.
+ */
+static const char *
+mido_fault_code_name(fault_status_t code)
+{
+	switch (code) {
+	case FSC_TRANSLATION_FAULT_L0:
+		return "transl0";
+	case FSC_TRANSLATION_FAULT_L1:
+		return "transl1";
+	case FSC_TRANSLATION_FAULT_L2:
+		return "transl2";
+	case FSC_TRANSLATION_FAULT_L3:
+		return "transl3";
+	case FSC_PERMISSION_FAULT_L1:
+		return "perm1";
+	case FSC_PERMISSION_FAULT_L2:
+		return "perm2";
+	case FSC_PERMISSION_FAULT_L3:
+		return "perm3";
+	case FSC_ACCESS_FLAG_FAULT_L1:
+		return "afault1";
+	case FSC_ACCESS_FLAG_FAULT_L2:
+		return "afault2";
+	case FSC_ACCESS_FLAG_FAULT_L3:
+		return "afault3";
+	default:
+		return "other";
+	}
+}
